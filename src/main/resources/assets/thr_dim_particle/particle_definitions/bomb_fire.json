{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tdp:bomb_fire",
			"type": "thr_dim_particle:tdp"
		},
		"components": {
			"minecraft:particle_initialization": {
				"per_render_expression": "v.ratio=v.particle_age/v.particle_lifetime;variable.size=1*(1-v.ratio);"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "30 * math.pow((v.radius + (math.abs(v.radius - 4) - v.radius + 4) / 2 - 3), 2)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "v.radius + (math.abs(v.radius - 4) - v.radius + 4) / 2 - 3",
				"direction": ["math.random(-50,50)", 30, "math.random(-50,50)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1,2)"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:particle_initial_speed": "math.random(20,50)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -50, 0],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 0.3,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.ratio",
					"gradient": {
						"0.0": "#ffffffff",
						"0.3": "#FFFF5F00",
						"0.56": "#FFFF0000",
						"1.0": "#ff000000"
					}
				}
			},
			"thr_dim_particle:appearance": {
				"size": ["variable.size", "variable.size", "variable.size"],
				"model_animation": {
					"type_frames": "thr_dim_particle:bomb_smoke_0"
				},
				"direction": {
					"mode": "custom_direction",
					"custom_direction": [
						"1 * v.particle_random_1 + (v.ratio * (v.particle_random_3 - 0.5))",
						"1 * v.particle_random_2 + (v.ratio * (v.particle_random_2 - 0.5))",
						"1 * v.particle_random_3 + (v.ratio * (v.particle_random_1 - 0.5))"
					]
				}
			}
		}
	}
}