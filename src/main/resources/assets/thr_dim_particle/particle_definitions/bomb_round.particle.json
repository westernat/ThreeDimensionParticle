{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tdp:bomb_round",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "thr_dim_particle:bomb_round"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 3
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, "math.random(-0.1,0.1)", 0]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = variable.radius * variable.particle_age / variable.particle_lifetime;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.random(v.radius + 0.6,v.radius + 1) * math.sin(v.particle_age / v.particle_lifetime * 180)", "math.random(v.radius + 0.6,v.radius + 1) * math.sin(v.particle_age / v.particle_lifetime * 180)"],
				"facing_camera_mode": "direction_y"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.26": "#8CEFFF00",
						"0.53": "#4FFF7400",
						"0.78": "#00FFFFFF"
					}
				}
			}
		}
	}
}
