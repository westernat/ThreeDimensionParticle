{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tdp:bomb_smoke",
			"type": "thr_dim_particle:tdp"
		},
		"events": {
			"bomb_round": {
				"particle_effect": {
					"effect": "tdp:bomb_round",
					"type": "emitter"
				}
			},
			"bomb_spark": {
				"particle_effect": {
					"effect": "tdp:bomb_spark",
					"type": "emitter"
				}
			},
			"bomb_fire": {
				"particle_effect": {
					"effect": "tdp:bomb_fire",
					"type": "emitter"
				}
			},
			"bomb_glitter": {
				"particle_effect": {
					"effect": "tdp:bomb_glitter",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_lifetime_events": {
				"creation_event": ["bomb_round", "bomb_spark", "bomb_fire", "bomb_glitter"]
			},
			"minecraft:emitter_initialization": {
				"per_update_expression": "v;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 500,
				"max_particles": 500
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.2
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 1,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1, 2)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)",
				"rotation_rate": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "math.random(0.1,15)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 1, 0],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.4,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"1.0": "#00FFFFFF"
					}
				}
			},
			"thr_dim_particle:appearance": {
				"size": [1, 1, 1],
				"model_animation": {
					"type_frames": [
						"thr_dim_particle:bomb_smoke_0",
						"thr_dim_particle:bomb_smoke_1",
						"thr_dim_particle:bomb_smoke_2",
						"thr_dim_particle:bomb_smoke_3",
						"thr_dim_particle:bomb_smoke_4",
						"thr_dim_particle:bomb_smoke_5",
						"thr_dim_particle:bomb_smoke_6",
						"thr_dim_particle:bomb_smoke_7"
					],
					"stretch_to_lifetime": true
				}
			}
		}
	}
}