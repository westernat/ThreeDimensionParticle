{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tdp:bomb_spark",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "thr_dim_particle:bomb_spark"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "100 * math.pow((v.radius + (math.abs(v.radius - 4) - v.radius + 4) / 2 - 3), 3)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "v.radius + (math.abs(v.radius - 4) - v.radius + 4) / 2 - 3",
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.1,0.3)"
			},
			"minecraft:particle_initial_speed": 60,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [1, 1],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.27": "#FFFFA700",
						"0.9": "#FFFF0000",
						"1.0": "#ff000000"
					}
				}
			}
		}
	}
}
