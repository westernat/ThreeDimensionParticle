{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tdp:campfire_smoke",
			"type": "thr_dim_particle:tdp"
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 4,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.4,
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.height * 0.75"
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = (1 - v.particle_age / v.particle_lifetime) * 0.8 * (v.particle_random_1 * 0.8 + 0.2)"
			},
			"minecraft:particle_initial_speed": 1.5,
			"minecraft:particle_motion_dynamic": {},
			"thr_dim_particle:appearance": {
				"size": ["variable.size", "variable.size", "variable.size"],
				"model_animation": {
					"type_frames": "thr_dim_particle:campfire_smoke"
				},
				"direction": {
					"mode": "custom_direction",
					"custom_direction": [
						"v.particle_random_1 + math.sin(math.sin(v.particle_random_3 * v.particle_age))",
						"v.particle_random_2 + (v.particle_age / v.particle_lifetime * (v.particle_random_2 - 0.5) * 10)",
						"v.particle_random_3 + math.sin(math.sin(v.particle_random_1 * v.particle_age))"
					]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.4,
				"collision_radius": 0.1
			}
		}
	}
}