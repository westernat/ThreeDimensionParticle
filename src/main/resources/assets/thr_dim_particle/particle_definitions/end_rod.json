{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tdp:end_rod",
			"type": "thr_dim_particle:tdp"
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 4,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"math.random(-0.2 * math.abs(v.y + v.z),0.2 * math.abs(v.y + v.z)) + (-0.5 * v.x)",
					"math.random(-0.2 * math.abs(v.x + v.z),0.2 * math.abs(v.x + v.z)) + (-0.5 * v.y)",
					"math.random(-0.2 * math.abs(v.x + v.y),0.2 * math.abs(v.x + v.y)) + (-0.5 * v.z)"
				],
				"direction": ["v.x", "v.y", "v.z"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.5,1)"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = 1 - v.particle_age / v.particle_lifetime"
			},
			"thr_dim_particle:appearance": {
				"size": ["variable.size", "variable.size", "variable.size"],
				"model_animation": {
					"type_frames": "thr_dim_particle:end_rod"
				},
				"direction": {
					"mode": "custom_direction",
					"custom_direction": [
						"v.particle_random_1 + (v.particle_age / v.particle_lifetime * (v.particle_random_3 - 0.5) * 10)",
						"v.particle_random_2 + (v.particle_age / v.particle_lifetime * (v.particle_random_2 - 0.5) * 10)",
						"v.particle_random_3 + (v.particle_age / v.particle_lifetime * (v.particle_random_1 - 0.5) * 10)"
					]
				}
			}
		}
	}
}