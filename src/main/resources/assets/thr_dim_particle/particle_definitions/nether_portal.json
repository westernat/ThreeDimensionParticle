{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "tdp:nether_portal",
            "type": "thr_dim_particle:tdp"
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": false
            },
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 2,
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_expression": {},
            "minecraft:emitter_shape_box": {
                "half_dimensions": ["1.5-v.x", 0.5, "v.x+0.5"],
                "surface_only": true,
                "direction": "inwards"
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 1
            },
            "minecraft:particle_initial_speed": 3,
            "minecraft:particle_motion_dynamic": {
                "linear_drag_coefficient": 3
            },
            "thr_dim_particle:appearance": {
                "size": ["variable.size", "variable.size", "variable.size"],
                "model_animation": {
                    "type_frames": "thr_dim_particle:nether_portal"
                },
                "direction": {
                    "mode": "custom_direction",
                    "custom_direction": [
                        "v.particle_random_1 + (v.particle_age / v.particle_lifetime * (v.particle_random_3 - 0.5) * 5)",
                        "v.particle_random_2 + (v.particle_age / v.particle_lifetime * (v.particle_random_2 - 0.5) * 5)",
                        "v.particle_random_3 + (v.particle_age / v.particle_lifetime * (v.particle_random_1 - 0.5) * 5)"
                    ]
                }
            },
            "minecraft:particle_initialization": {
                "per_render_expression": "variable.size = (1 - v.particle_age / v.particle_lifetime) * 0.6"
            },
            "minecraft:particle_appearance_tinting": {
                "color": [1, 1, 1, 1]
            }
        }
    }
}