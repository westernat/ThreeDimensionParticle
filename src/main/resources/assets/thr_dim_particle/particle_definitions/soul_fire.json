{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tdp:soul_fire",
			"type": "thr_dim_particle:tdp"
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.3,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.5,1)"
			},
			"minecraft:particle_initial_speed": 0.5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.sin(v.particle_age * 900 * v.particle_random_1) * 3", 10, "math.cos(v.particle_age * 400 * v.particle_random_1) * 3"],
				"linear_drag_coefficient": 5
			},
			"thr_dim_particle:appearance": {
				"size": ["variable.size", "variable.size", "variable.size"],
				"model_animation": {
					"type_frames": "thr_dim_particle:soul_fire"
				},
				"direction": {
					"mode": "custom_direction",
					"custom_direction": [
						"v.particle_random_1 + (v.particle_age / v.particle_lifetime * (v.particle_random_3 - 0.5) * 10)",
						"v.particle_random_2 + (v.particle_age / v.particle_lifetime * (v.particle_random_2 - 0.5) * 10)",
						"v.particle_random_3 + (v.particle_age / v.particle_lifetime * (v.particle_random_1 - 0.5) * 10)"
					]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 10,
				"collision_radius": 0.2
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = (1 - v.particle_age / v.particle_lifetime) * 0.6"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.5": "#FF7cf2f5",
						"1.0": "#FF4caaff"
					}
				}
			}
		}
	}
}
